---
// Extends Starlight's default footer with the documentation licence notice and
// the build-time release version. Version comes from src/version.json, written
// by scripts/sync-content.mjs during prebuild.
import Default from '@astrojs/starlight/components/Footer.astro';
import versionInfo from '../version.json';
---

<Default><slot /></Default>

<div class="docs-license-footer">
  <p class="docs-version">Latest release: <strong>{versionInfo.version}</strong></p>
  <p>
    Documentation is licensed under
    <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">Creative Commons Attribution 4.0 International (CC BY 4.0)</a>.
    &copy; 2026 SHUKE LABS LTD. The my-ai-team software itself is separately licensed and proprietary.
  </p>
</div>

<style>
  .docs-license-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .docs-license-footer .docs-version {
    margin-bottom: 0.25rem;
  }
</style>
